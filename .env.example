# Turso production connection (optional in development)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local fallback database file
LOCAL_DATABASE_URL=file:./data/fvg.db
# Use a long, random value in production (Vercel environment variable)
AUTH_SECRET=replace-with-a-long-random-secret
# Local development only; leave blank in production.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
